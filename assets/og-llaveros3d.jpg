<svg width="1200" height="630" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#2563eb;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#7dd3fc;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Fondo -->
  <rect width="1200" height="630" fill="url(#bg)"/>
  
  <!-- Logo -->
  <g transform="translate(100, 200)">
    <rect x="4" y="8" width="56" height="48" rx="12" fill="white"/>
    <circle cx="32" cy="16" r="4" fill="#2563eb"/>
    <path d="M24 32 L40 32 L38 40 L26 40 Z" fill="#2563eb"/>
    <rect x="28" y="36" width="8" height="12" fill="#2563eb"/>
    <circle cx="32" cy="48" r="2" fill="#2563eb"/>
  </g>
  
  <!-- Texto -->
  <text x="200" y="250" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="white">
    Llaveros3D.com
  </text>
  <text x="200" y="300" font-family="Arial, sans-serif" font-size="24" fill="white" opacity="0.9">
    Convierte tu foto en un llavero personalizado
  </text>
  
  <!-- Llavero de ejemplo -->
  <g transform="translate(800, 200)">
    <circle cx="0" cy="0" r="60" fill="white"/>
    <circle cx="0" cy="-40" r="8" fill="#e5e7eb"/>
    <circle cx="0" cy="-40" r="4" fill="white"/>
    <circle cx="0" cy="-40" r="12" fill="none" stroke="#cbd5e1" stroke-width="2"/>
  </g>
</svg>
